# Copy this file to .env (which is gitignored) and fill in the values.
# Spring Boot loads .env automatically via `spring.config.import` in application.yml.

# Required: get a free key at https://aistudio.google.com/apikey (no billing required).
GEMINI_API_KEY=

# Optional: defaults to gemini-2.5-flash-lite (most generous free tier).
# Try gemini-2.5-flash if you want slightly smarter responses and can live with ~5 RPM.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: switch chat-model providers without editing application.yml.
#   gemini    — default, hits the Gemini API (uses GEMINI_API_KEY).
#   lm-studio — points at a local OpenAI-compatible server (LM Studio, Ollama with the OpenAI
#               shim, vLLM, etc.). No GEMINI_API_KEY needed.
# SPRING_PROFILES_ACTIVE=lm-studio

# Only used when SPRING_PROFILES_ACTIVE=lm-studio:
# LM_STUDIO_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=qwen/qwen3.6-35b-a3b

# Optional: enables LangSmith tracing. Get a key at https://smith.langchain.com.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=spring-examples-langgraph
